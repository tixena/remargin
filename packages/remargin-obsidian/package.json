{
  "name": "remargin-obsidian",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "description": "Remargin plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "generate-types": "cd ../.. && cargo xtask generate-types && cd packages/remargin-obsidian && pnpm exec biome check --write src/generated/",
    "predev": "pnpm run generate-types",
    "dev": "node esbuild.config.mjs",
    "prebuild": "pnpm run generate-types",
    "build": "node esbuild.config.mjs production",
    "lint": "pnpm exec biome check --write --diagnostic-level=error",
    "test": "node --loader=./test-loader.mjs --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diacritic-regex": "1.2.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "latest",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.2",
    "esbuild-postcss": "0.0.4",
    "obsidian": "1.13.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3"
  }
}
